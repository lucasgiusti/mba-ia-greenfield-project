# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@streamtube.com

# Object storage (MinIO). Credentials and bucket are also interpolated by Compose.
# STORAGE_ENDPOINT is used server-side (Compose service name); STORAGE_PUBLIC_ENDPOINT
# is the host signed into URLs handed to clients (browser on the host machine).
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube-secret
STORAGE_BUCKET=streamtube

# Queue (Redis for BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Upload
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_PART_SIZE_BYTES=104857600
UPLOAD_PART_URL_TTL_SECONDS=3600
